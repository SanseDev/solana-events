{
  "expo": {
    "name": "Solwhere",
    "slug": "solana-events",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solanaevents",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#090D18"
      },
      "package": "com.sansedev.solwhere"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Solwhere to add events you choose to your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Solwhere to use your location to suggest events near you.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D18",
          "dark": {
            "backgroundColor": "#090D18",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "340b53b9-af1a-4be4-b79f-b00a37a9bec3"
      }
    }
  }
}
